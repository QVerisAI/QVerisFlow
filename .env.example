# ===========================================
# Agent Framework 环境变量配置
# ===========================================
# 复制此文件为 .env 并根据需要修改配置
# cp .env.example .env

# -------------------------------------------
# PostgreSQL 数据库配置
# -------------------------------------------
ENABLE_POSTGRES=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agent_framework
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# 完整数据库 URL（可选，覆盖上面的配置）
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_framework

# -------------------------------------------
# Redis 缓存配置
# -------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 完整 Redis URL（可选）
# REDIS_URL=redis://localhost:6379/0

# -------------------------------------------
# MinIO/OSS 对象存储配置
# -------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agent-framework
MINIO_SECURE=false

# 阿里云 OSS（可选，生产环境）
# OSS_PROVIDER=aliyun
# ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# ALIYUN_OSS_ACCESS_KEY_ID=your_access_key_id
# ALIYUN_OSS_ACCESS_KEY_SECRET=your_access_key_secret
# ALIYUN_OSS_BUCKET=your_bucket_name

# -------------------------------------------
# 功能开关
# -------------------------------------------
ENABLE_POSTGRES=true
ENABLE_REDIS=true
ENABLE_OSS=true

# -------------------------------------------
# 检查点存储配置
# -------------------------------------------
# 类型: memory | redis | postgresql | file
CHECKPOINT_TYPE=redis
CHECKPOINT_REDIS_PREFIX=langgraph:checkpoint:
CHECKPOINT_REDIS_TTL=86400

# -------------------------------------------
# 追踪存储配置
# -------------------------------------------
# 类型: file | database | oss
TRACE_STORAGE_TYPE=database
TRACE_RETENTION_DAYS=30

# -------------------------------------------
# LLM 配置
# -------------------------------------------
# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenAI API（可选）
OPENAI_API_KEY=your_openai_api_key

# 默认模型
DEFAULT_MODEL=claude-sonnet-4-20250514
DEFAULT_TEMPERATURE=0.3
DEFAULT_MAX_TOKENS=4096

# -------------------------------------------
# Qveris API 配置（可选）
# -------------------------------------------
QVERIS_API_BASE_URL=https://api.qveris.com
QVERIS_API_KEY=your_qveris_api_key

# -------------------------------------------
# Web 服务配置
# -------------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_DEBUG=true
WEB_RELOAD=true

# CORS 配置
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -------------------------------------------
# 日志配置
# -------------------------------------------
LOG_LEVEL=INFO
# LOG_FORMAT: 可选值为 "json" (结构化JSON) 或自定义格式字符串
# 默认使用标准格式: %(asctime)s - %(levelname)s - %(name)s - %(message)s
LOG_FORMAT=

# -------------------------------------------
# 工作空间配置
# -------------------------------------------
WORKSPACE_BASE_PATH=./workspaces
STORAGE_BASE_PATH=./storage
